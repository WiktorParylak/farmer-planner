<!--
  The installer / uninstaller window. Loaded at runtime with XamlReader (csc
  can't compile XAML), so no x:Class and no event attributes - Setup.cs finds
  the named elements and wires them. The LOGO placeholder in the Canvas is replaced by tools/build-installer.js
  with the paths of Assets/Logo.svg. Colours are the app's tokens from
  src/renderer/style.css.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farmer Planner" Width="800" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#16261D"/>
        <SolidColorBrush x:Key="CanvasAlt" Color="#1E3327"/>
        <SolidColorBrush x:Key="Surface" Color="#F1E9D2"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#E6DAB4"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#F8F3E4"/>
        <SolidColorBrush x:Key="Ink" Color="#1C2A20"/>
        <SolidColorBrush x:Key="InkSoft" Color="#5B6456"/>
        <SolidColorBrush x:Key="InkFaint" Color="#8A917E"/>
        <SolidColorBrush x:Key="Primary" Color="#3F6B44"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#2C4C31"/>
        <SolidColorBrush x:Key="Accent" Color="#C97A2B"/>
        <SolidColorBrush x:Key="AccentDark" Color="#9C5D1D"/>
        <SolidColorBrush x:Key="Rust" Color="#A6452B"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#C9BC97"/>
        <SolidColorBrush x:Key="OnCanvas" Color="#F1E9D2"/>
        <SolidColorBrush x:Key="OnCanvasSoft" Color="#9FAE9A"/>

        <!-- Replaced from code with the embedded fonts when they're there. -->
        <FontFamily x:Key="Display">Bahnschrift</FontFamily>
        <FontFamily x:Key="Body">Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <!-- The striped band of the app's cards (amber / dark green, 135deg). -->
        <LinearGradientBrush x:Key="Stripe" MappingMode="Absolute" StartPoint="0,0" EndPoint="17,17" SpreadMethod="Repeat">
            <GradientStop Color="#C97A2B" Offset="0"/>
            <GradientStop Color="#C97A2B" Offset="0.5"/>
            <GradientStop Color="#2C4C31" Offset="0.5"/>
            <GradientStop Color="#2C4C31" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{StaticResource Surface}"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Rust}"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1.5"
                                CornerRadius="999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Txt" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="17">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                                    BorderBrush="{StaticResource BorderStrong}" Background="{StaticResource SurfaceSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="6" Background="{StaticResource SurfaceAlt}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left" Background="{StaticResource Stripe}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="38"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Body}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource Canvas}" BorderBrush="#2C4C31" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the app's dashboard look - pine with faint diagonal lines, the logo. -->
            <Border Grid.Column="0" CornerRadius="18,0,0,18">
                <Border.Background>
                    <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="33,33" SpreadMethod="Repeat">
                        <GradientStop Color="#1B2D22" Offset="0"/>
                        <GradientStop Color="#1B2D22" Offset="0.05"/>
                        <GradientStop Color="#16261D" Offset="0.05"/>
                        <GradientStop Color="#16261D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Grid x:Name="DragArea" Grid.Column="0" Background="Transparent">
                <StackPanel VerticalAlignment="Center" Margin="40,0,30,0">
                    <Viewbox Width="236" HorizontalAlignment="Left">
                        <Canvas Width="398.97" Height="97.49">
                            {{LOGO}}
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="BY WIKTOR PARYLAK" Margin="96,12,0,0" FontFamily="{DynamicResource Mono}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource OnCanvasSoft}"/>
                    <TextBlock x:Name="Tagline" Margin="0,38,0,0" FontFamily="{DynamicResource Body}" FontSize="15" LineHeight="22"
                               Foreground="{StaticResource OnCanvas}" TextWrapping="Wrap" Opacity="0.85"/>
                </StackPanel>
                <TextBlock x:Name="VersionLabel" Margin="40,0,0,26" VerticalAlignment="Bottom" FontFamily="{DynamicResource Mono}"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnCanvasSoft}"/>
            </Grid>

            <!-- Right: a wheat card with a striped top band, like the app's panels. -->
            <Border Grid.Column="1" Margin="0,18,18,18" CornerRadius="16" Background="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{StaticResource Stripe}"/>
                    <Button x:Name="CloseBtn" Grid.Row="1" Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="5"/>

                    <Grid Grid.Row="1" Margin="38,34,38,30">

                        <!-- Install: welcome -->
                        <Grid x:Name="PanelWelcome">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Heading}"/>
                                <Border Width="54" Height="6" CornerRadius="3" Margin="0,12,0,0" HorizontalAlignment="Left" Background="{StaticResource Stripe}"/>
                                <TextBlock x:Name="WelcomeText" Style="{StaticResource BodyText}" Margin="0,16,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,22,0,0">
                                <TextBlock x:Name="FolderLabel" Style="{StaticResource Label}"/>
                                <Border Margin="0,6,0,16" Padding="12,9" CornerRadius="10" Background="{StaticResource SurfaceSoft}"
                                        BorderBrush="{StaticResource SurfaceAlt}" BorderThickness="1">
                                    <DockPanel>
                                        <Button x:Name="ChangeFolderBtn" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FolderPath" FontFamily="{DynamicResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <CheckBox x:Name="ShortcutBox" IsChecked="True"/>
                                <CheckBox x:Name="RunBox" IsChecked="True"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="InstallBtn" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Uninstall: confirm -->
                        <Grid x:Name="PanelUninstall" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="UninstallTitle" Style="{StaticResource Heading}"/>
                                <Border Width="54" Height="6" CornerRadius="3" Margin="0,12,0,0" HorizontalAlignment="Left" Background="{StaticResource Stripe}"/>
                                <TextBlock x:Name="UninstallText" Style="{StaticResource BodyText}" Margin="0,16,0,22"/>
                                <CheckBox x:Name="DeleteDataBox" IsChecked="False"/>
                                <TextBlock x:Name="DeleteDataHint" Style="{StaticResource BodyText}" FontSize="12" Margin="30,-4,0,0" Foreground="{StaticResource InkFaint}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UninstallCancelBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True"/>
                                <Button x:Name="UninstallBtn" Style="{StaticResource DangerButton}"/>
                            </StackPanel>
                        </Grid>

                        <!-- The app is running -->
                        <Grid x:Name="PanelRunning" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="RunningTitle" Style="{StaticResource Heading}"/>
                                <Border Width="54" Height="6" CornerRadius="3" Margin="0,12,0,0" HorizontalAlignment="Left" Background="{StaticResource Stripe}"/>
                                <TextBlock x:Name="RunningText" Style="{StaticResource BodyText}" Margin="0,16,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RunningCancelBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button x:Name="RunningCloseBtn" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Working -->
                        <Grid x:Name="PanelProgress" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}"/>
                                <TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}" Margin="0,12,0,26"/>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="ProgressPercent" Margin="0,10,0,0" FontFamily="{DynamicResource Mono}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Done -->
                        <Grid x:Name="PanelDone" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Primary}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Surface}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" Margin="0,22,0,0"/>
                                <TextBlock x:Name="DoneText" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DoneCloseBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button x:Name="LaunchBtn" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Error -->
                        <Grid x:Name="PanelError" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Rust}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Surface}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ErrorTitle" Style="{StaticResource Heading}" Foreground="{StaticResource Rust}" Margin="0,22,0,0"/>
                                <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveLogBtn" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button x:Name="RetryBtn" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
