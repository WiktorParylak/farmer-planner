{
  "name": "farmer-planner",
  "version": "0.9.8",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node tools/start.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.farmerplanner.app",
    "productName": "Farmer Planner",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "Assets/Logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  },
  "allowScripts": {
    "electron@40.4.1": true,
    "electron-winstaller@5.4.0": true
  }
}
