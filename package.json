{
  "name": "farmer-planner",
  "version": "1.0.2",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.farmerplanner.app",
    "productName": "Farmer Planner",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "Assets/Logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
